@{
    var L = Law_Firm_Management.Models.LawFirmRecordLabels.From(ViewData);
    ViewData["Title"] = $"Import {L.Short} State Mappings";
}

<h2>Import @L.Short State Mappings</h2>

@if (TempData["Message"] != null)
{
    <div class="alert alert-success">@TempData["Message"]</div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-warning">@Html.Raw(TempData["Error"])</div>
}

<form asp-action="ImportStateMappings" method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()

    <div class="mb-3">
        <label for="file" class="form-label">CSV File</label>
        <input type="file" name="file" id="file" class="form-control" accept=".csv" />
        <div class="form-text">The FirmName column must match an existing @(L.Full.ToLower()) name exactly.</div>
    </div>

    <button type="submit" class="btn btn-primary">Import State Mappings</button>
    <a asp-action="DownloadStateMappingTemplate" class="btn btn-outline-secondary">Download Template</a>
    <a asp-action="Index" class="btn btn-secondary">Back</a>
</form>
