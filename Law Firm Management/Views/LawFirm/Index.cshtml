@model List<Law_Firm_Management.Models.LawFirmListRowVm>

@{
    var L = Law_Firm_Management.Models.LawFirmRecordLabels.From(ViewData);
    ViewData["Title"] = $"{L.Full} List";
    string sort = (ViewBag.Sort as string) ?? "FIRM_NAME";
    string dir = (ViewBag.Dir as string) ?? "ASC";
    string search = (ViewBag.Search as string) ?? "";
    string status = (ViewBag.Status as string) ?? "";

    // "No COCO #": firms only - a firm with no COCO number can't appear on the Exceptions dashboard.
    bool tracksCoco = L == Law_Firm_Management.Models.LawFirmRecordLabels.Firm;
    bool noCoco = ViewData["NoCoco"] is true;
    int noCocoCount = ViewData["NoCocoCount"] is int c ? c : 0;
    string? noCocoRoute = noCoco ? "true" : null;   // null drops it from links

    string ToggleDir(string col)
    {
        if (!string.Equals(sort, col, StringComparison.OrdinalIgnoreCase)) return "ASC";
        return string.Equals(dir, "ASC", StringComparison.OrdinalIgnoreCase) ? "DESC" : "ASC";
    }
}

<div class="mb-3 d-flex gap-2">
    <a class="btn btn-primary" asp-action="Create">Add New @L.Short</a>
    <a class="btn btn-outline-secondary" asp-action="Import">Import @L.ShortPlural</a>
    <a class="btn btn-outline-secondary" asp-action="Export"
       asp-route-search="@search"
       asp-route-status="@status"
       asp-route-sort="@sort"
       asp-route-dir="@dir"
       asp-route-noCoco="@noCocoRoute">
        Export
    </a>
</div>

@if (TempData["Message"] != null)
{
    <div class="alert alert-success">@TempData["Message"]</div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@Html.Raw(TempData["Error"])</div>
}

@if (tracksCoco && noCocoCount > 0)
{
    <div class="alert alert-warning d-flex flex-wrap justify-content-between align-items-center gap-2 py-2">
        <span>
            <strong>@noCocoCount</strong> @(noCocoCount == 1 ? "firm has" : "firms have") no COCO number in their state mappings,
            so @(noCocoCount == 1 ? "it doesn't" : "they don't") appear on the Exceptions dashboard.
        </span>
        @if (noCoco)
        {
            <a asp-action="Index" class="btn btn-sm btn-outline-dark">Show all firms</a>
        }
        else
        {
            <a asp-action="Index" asp-route-noCoco="true" class="btn btn-sm btn-outline-dark">Show them</a>
        }
    </div>
}

<form method="get" class="row g-2 mb-3 align-items-center">
    <div class="@(tracksCoco ? "col-md-3" : "col-md-4")">
        <input type="text" name="search" value="@search" class="form-control" placeholder="Search @(L.Short.ToLower())..." />
    </div>
    <div class="col-md-3">
        <select name="status" class="form-select">
            <option value="">All Statuses</option>
            <option value="Active" selected="@(status == "Active")">Active</option>
            <option value="Inactive" selected="@(status == "Inactive")">Inactive</option>
        </select>
    </div>
    @if (tracksCoco)
    {
        <div class="col-md-2">
            <div class="form-check mb-0">
                <input type="checkbox" name="noCoco" value="true" class="form-check-input" id="noCocoFilter" checked="@noCoco" />
                <label class="form-check-label" for="noCocoFilter">No COCO # only</label>
            </div>
        </div>
    }
    <div class="col-md-2">
        <button type="submit" class="btn btn-secondary w-100">Search</button>
    </div>
    <div class="col-md-2">
        <a asp-action="Index" class="btn btn-outline-secondary w-100">Clear</a>
    </div>
</form>

<table class="table table-bordered">
    <thead class="table-light">
        <tr>
            <th>
                <a asp-action="Index"
                   asp-route-sort="FIRM_NAME"
                   asp-route-dir="@ToggleDir("FIRM_NAME")"
                   asp-route-search="@search"
                   asp-route-status="@status"
                   asp-route-noCoco="@noCocoRoute">
                    @L.Short
                </a>
            </th>
            <th>
                <a asp-action="Index"
                   asp-route-sort="SHORT_NAME"
                   asp-route-dir="@ToggleDir("SHORT_NAME")"
                   asp-route-search="@search"
                   asp-route-status="@status"
                   asp-route-noCoco="@noCocoRoute">
                    Short Name
                </a>
            </th>
            <th>
                <a asp-action="Index"
                   asp-route-sort="STATUS"
                   asp-route-dir="@ToggleDir("STATUS")"
                   asp-route-search="@search"
                   asp-route-status="@status"
                   asp-route-noCoco="@noCocoRoute">
                    Status
                </a>
            </th>
            <th>
                <a asp-action="Index"
                   asp-route-sort="STATE_COUNT"
                   asp-route-dir="@ToggleDir("STATE_COUNT")"
                   asp-route-search="@search"
                   asp-route-status="@status"
                   asp-route-noCoco="@noCocoRoute">
                    States
                </a>
            </th>
            <th>
                <a asp-action="Index"
                   asp-route-sort="CONTACT_COUNT"
                   asp-route-dir="@ToggleDir("CONTACT_COUNT")"
                   asp-route-search="@search"
                   asp-route-status="@status"
                   asp-route-noCoco="@noCocoRoute">
                    Contacts
                </a>
            </th>
            <th>
                <a asp-action="Index"
                   asp-route-sort="UPDATED_DATE"
                   asp-route-dir="@ToggleDir("UPDATED_DATE")"
                   asp-route-search="@search"
                   asp-route-status="@status"
                   asp-route-noCoco="@noCocoRoute">
                    Last Updated
                </a>
            </th>
            <th>
                <a asp-action="Index"
                   asp-route-sort="LAST_INVOICE"
                   asp-route-dir="@ToggleDir("LAST_INVOICE")"
                   asp-route-search="@search"
                   asp-route-status="@status"
                   asp-route-noCoco="@noCocoRoute">
                    Last Invoice
                </a>
            </th>

            <th>
                <a asp-action="Index"
                   asp-route-sort="LAST_REMIT"
                   asp-route-dir="@ToggleDir("LAST_REMIT")"
                   asp-route-search="@search"
                   asp-route-status="@status"
                   asp-route-noCoco="@noCocoRoute">
                    Last Remit
                </a>
            </th>

            <th>
                <a asp-action="Index"
                   asp-route-sort="LAST_COST"
                   asp-route-dir="@ToggleDir("LAST_COST")"
                   asp-route-search="@search"
                   asp-route-status="@status"
                   asp-route-noCoco="@noCocoRoute">
                    Last Cost
                </a>
            </th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @if (Model == null || !Model.Any())
        {
            <tr>
                <td colspan="10" class="text-center">No @L.FullPlural.ToLower() found.</td>
            </tr>
        }
        else
        {
            @foreach (var r in Model)
            {
                <tr>
                    <td>
                        @r.FirmName
                        @if (tracksCoco && r.CocoNoCount == 0)
                        {
                            <span class="badge bg-warning text-dark ms-1"
                                  title="No COCO number in state mappings, so this firm won't appear on the Exceptions dashboard">No COCO #</span>
                        }
                    </td>
                    <td>@r.ShortName</td>
                    <td>@r.Status</td>
                    <td>@r.StateCount</td>
                    <td>@r.ContactCount</td>
                    <td>@(r.UpdatedDate?.ToString("d") ?? "")</td>
                    <td>@(r.LastInvoice?.ToString("d") ?? "")</td>
                    <td>@(r.LastRemit?.ToString("d") ?? "")</td>
                    <td>@(r.LastCostFile?.ToString("d") ?? "")</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@r.LawFirmId">View</a> |
                        <a asp-action="Edit" asp-route-id="@r.LawFirmId">Edit</a>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>