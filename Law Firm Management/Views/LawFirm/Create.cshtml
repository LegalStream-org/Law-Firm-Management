@model Law_Firm_Management.Models.LawFirmEditVm

@{
    var L = Law_Firm_Management.Models.LawFirmRecordLabels.From(ViewData);
    ViewData["Title"] = $"Add {L.Full}";
}

<h2>Add @L.Full</h2>

<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <div class="row g-3">
        <div class="col-md-6">
            <label class="form-label">@L.Short Name <span class="text-danger">*</span></label>
            <input asp-for="FirmName" class="form-control" />
            <span asp-validation-for="FirmName" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label class="form-label">Short Name <span class="text-danger">*</span></label>
            <input asp-for="ShortName" class="form-control" />
            <span asp-validation-for="ShortName" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label class="form-label">Status</label>
            <select asp-for="Status" class="form-select">
                <option>Active</option>
                <option>Inactive</option>
            </select>
        </div>

        <div class="col-md-4">
            <label class="form-label">Phone <span class="text-danger">*</span></label>
            <input asp-for="MainPhone" class="form-control" />
            <span asp-validation-for="MainPhone" class="text-danger"></span>
        </div>
        <div class="col-md-4">
            <label class="form-label">Email <span class="text-danger">*</span></label>
            <input asp-for="MainEmail" class="form-control" />
            <span asp-validation-for="MainEmail" class="text-danger"></span>
        </div>
        <div class="col-md-4">
            <label class="form-label">Website</label>
            <input asp-for="Website" class="form-control" />
        </div>

        <div class="col-md-6">
            <label class="form-label">Address 1 <span class="text-danger">*</span></label>
            <input asp-for="Address1" class="form-control" />
            <span asp-validation-for="Address1" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label class="form-label">Address 2</label>
            <input asp-for="Address2" class="form-control" />
        </div>

        <div class="col-md-4">
            <label class="form-label">City <span class="text-danger">*</span></label>
            <input asp-for="City" class="form-control" />
            <span asp-validation-for="City" class="text-danger"></span>
        </div>
        <div class="col-md-4">
            <label class="form-label">State <span class="text-danger">*</span></label>
            <input asp-for="State" class="form-control" />
            <span asp-validation-for="State" class="text-danger"></span>
        </div>
        <div class="col-md-4">
            <label class="form-label">Zip <span class="text-danger">*</span></label>
            <input asp-for="Zip" class="form-control" />
            <span asp-validation-for="Zip" class="text-danger"></span>
        </div>
        <div class="col-md-4">
            <label class="form-label">EIN</label>
            <input asp-for="EIN" class="form-control" placeholder="12-3456789 or 123-45-6789" />
            <span asp-validation-for="EIN" class="text-danger"></span>
        </div>
        <div class="col-md-4">
            <label class="form-label">Profile Notes</label>
            <input asp-for="ProfileNotes" class="form-control" />
        </div>
      
    </div>

    <div class="mt-3">
        <button type="submit" class="btn btn-primary">Save</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
