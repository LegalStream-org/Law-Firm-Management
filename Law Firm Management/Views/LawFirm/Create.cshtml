@model Law_Firm_Management.Models.LawFirmEditVm

@{
    ViewData["Title"] = "Add Law Firm";
}

<h2>Add Law Firm</h2>

<form asp-action="Create" method="post">
    <div class="row g-3">
        <div class="col-md-6">
            <label class="form-label">Firm Name</label>
            <input asp-for="FirmName" class="form-control" />
        </div>
        <div class="col-md-3">
            <label class="form-label">Short Name</label>
            <input asp-for="ShortName" class="form-control" />
        </div>
        <div class="col-md-3">
            <label class="form-label">Status</label>
            <select asp-for="Status" class="form-select">
                <option>Active</option>
                <option>Inactive</option>
            </select>
        </div>

        <div class="col-md-4">
            <label class="form-label">Phone</label>
            <input asp-for="MainPhone" class="form-control" />
        </div>
        <div class="col-md-4">
            <label class="form-label">Email</label>
            <input asp-for="MainEmail" class="form-control" />
        </div>
        <div class="col-md-4">
            <label class="form-label">Website</label>
            <input asp-for="Website" class="form-control" />
        </div>

        <div class="col-md-6">
            <label class="form-label">Address 1</label>
            <input asp-for="Address1" class="form-control" />
        </div>
        <div class="col-md-6">
            <label class="form-label">Address 2</label>
            <input asp-for="Address2" class="form-control" />
        </div>

        <div class="col-md-4">
            <label class="form-label">City</label>
            <input asp-for="City" class="form-control" />
        </div>
        <div class="col-md-4">
            <label class="form-label">State</label>
            <input asp-for="State" class="form-control" />
        </div>
        <div class="col-md-4">
            <label class="form-label">Zip</label>
            <input asp-for="Zip" class="form-control" />
        </div>
        <div class="col-md-4">
            <label class="form-label">Profile Notes</label>
            <input asp-for="ProfileNotes" class="form-control" />
        </div>
      
    </div>

    <div class="mt-3">
        <button type="submit" class="btn btn-primary">Save</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </div>
</form>
