@model Law_Firm_Management.Models.LawFirmEditVm

@{
    var L = Law_Firm_Management.Models.LawFirmRecordLabels.From(ViewData);
    ViewData["Title"] = $"Edit {L.Full}";
}

<partial name="_Partials/Edit/_Styles.cshtml" />

<div class="container-fluid py-3">

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <div>
            <h2 class="mb-0">@Model.FirmName</h2>
            <div class="text-muted">Edit @L.Full</div>
        </div>

        <div class="d-flex gap-2">
            <a asp-action="Details" asp-route-id="@Model.LawFirmId" class="btn btn-outline-primary">View</a>
            <a asp-action="Index" class="btn btn-outline-secondary">Back</a>
        </div>
    </div>

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success">@TempData["Message"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="row g-3">

        <div class="col-12 col-xl-8">

            <partial name="_Partials/Edit/_Profile.cshtml" />

            <partial name="_Partials/Edit/_StateMappings.cshtml" />

            <partial name="_Partials/Edit/_Contacts.cshtml" />

            <partial name="_Partials/Edit/_Notes.cshtml" />

            <partial name="_Partials/Edit/_Documents.cshtml" />

        </div>

        <!-- Right Side -->
        <div class="col-12 col-xl-4">
            <div class="sticky-side">

                <partial name="_Partials/Edit/_Summary.cshtml" />

                <partial name="_Partials/Edit/_AccountingMapping.cshtml" />

                <partial name="_Partials/Edit/_Audit.cshtml" />

                <partial name="_Partials/Edit/_DangerZone.cshtml" />

            </div>
        </div>
     
    </div>
</div>

<partial name="_Partials/Edit/Modals/_AccountingMapConflict.cshtml" />

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    @if (Model.PendingAccountingMapConflict != null)
    {
        @* Sep 08 - the warning is the point of the redirect, so it opens itself. Bootstrap's bundle is
           already loaded by _Layout above this section. *@
        <script>
            document.addEventListener("DOMContentLoaded", function () {
                var conflictModal = document.getElementById("accountingMapConflictModal");
                if (conflictModal) {
                    new bootstrap.Modal(conflictModal).show();
                }
            });
        </script>
    }
}
