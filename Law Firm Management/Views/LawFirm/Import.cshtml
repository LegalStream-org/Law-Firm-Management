@{
    var L = Law_Firm_Management.Models.LawFirmRecordLabels.From(ViewData);
    ViewData["Title"] = $"Import {L.FullPlural}";
}

<h2>Import @L.FullPlural</h2>

@if (TempData["Message"] != null)
{
    <div class="alert alert-success">@TempData["Message"]</div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-warning">@Html.Raw(TempData["Error"])</div>
}

<form asp-action="Import" method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()

    <div class="mb-3">
        <label for="file" class="form-label">CSV File</label>
        <input type="file" name="file" id="file" class="form-control" accept=".csv" />
        <div class="form-text">New records are added to the @L.FullPlural list. A name already used by a law firm or agency is skipped.</div>
    </div>

    <button type="submit" class="btn btn-primary">Import</button>
    <a asp-action="DownloadLawFirmTemplate" class="btn btn-outline-secondary">Download Template</a>
    <a asp-action="Index" class="btn btn-secondary">Back</a>
</form>
