@model Law_Firm_Management.Models.LawFirmEditVm
@{
    var L = Law_Firm_Management.Models.LawFirmRecordLabels.From(ViewData);
}

<!-- Notes -->
<div class="card lf-card mb-3">
    <div class="card-header">
        <h5 class="mb-0">Notes</h5>
        <div class="text-muted small">Internal note history for this @(L.Short.ToLower()).</div>
    </div>

    <div class="card-body">

        <form asp-action="AddNote" method="post" class="row g-2 mb-3">
            @Html.AntiForgeryToken()

            <input type="hidden" name="LawFirmId" value="@Model.LawFirmId" />
            <input type="hidden" name="returnAction" value="Edit" />

            <div class="col-md-2">
                <label class="form-label">Note Type</label>
                <select name="NoteType" class="form-select form-select-sm">
                    @foreach (var type in Model.NoteOptions)
                    {
                        <option value="@type">@type</option>
                    }
                </select>
            </div>

            <div class="col-md-8">
                <label class="form-label">Note</label>
                <input name="NoteText" class="form-control" placeholder="Enter note" />
            </div>

            <div class="col-md-2">
                <label class="form-label">&nbsp;</label>
                <button type="submit" class="btn btn-outline-primary w-100">Add Note</button>
            </div>
        </form>

        <div class="table-responsive">
            <table class="table table-sm table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width:160px;">Date</th>
                        <th style="width:140px;">Type</th>
                        <th style="width:160px;">Entered By</th>
                        <th>Note</th>
                        <th style="width:180px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Notes.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-muted">No notes found.</td>
                        </tr>
                    }
                    else
                    {
                        foreach (var n in Model.Notes)
                        {
                            var formId = $"noteForm_{n.LawFirmNoteId}";

                            <tr>
                                <td>@n.EnteredDate.ToString("MM/dd/yyyy HH:mm")</td>
                                <td><input name="NoteType" form="@formId" value="@n.NoteType" class="form-control form-control-sm" /></td>
                                <td>@n.EnteredBy</td>
                                <td><input name="NoteText" form="@formId" value="@n.NoteText" class="form-control form-control-sm" /></td>

                                <td>
                                    <div class="d-flex gap-1">
                                        <form id="@formId" asp-action="UpdateNote" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="LawFirmNoteId" value="@n.LawFirmNoteId" />
                                            <input type="hidden" name="LawFirmId" value="@Model.LawFirmId" />
                                            <button type="submit" class="btn btn-sm btn-outline-primary">Save</button>
                                        </form>

                                        <form asp-action="DeleteNote" method="post" class="d-inline" onsubmit="return confirm('Delete this note?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="lawFirmNoteId" value="@n.LawFirmNoteId" />
                                            <input type="hidden" name="lawFirmId" value="@Model.LawFirmId" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

    </div>
</div>
