@model Law_Firm_Management.Models.LawFirmEditVm
@{
    var L = Law_Firm_Management.Models.LawFirmRecordLabels.From(ViewData);
}
@{
    var mainFormId = "lawFirmProfileForm";
}

<!-- Profile -->
<div class="card lf-card mb-3">
    <div class="card-header">
        <h5 class="mb-0">@L.Short Profile</h5>
        <div class="text-muted small">Basic @(L.Short.ToLower()) information and profile notes.</div>
    </div>

    <div class="card-body">
        <form id="@mainFormId" asp-action="Edit" method="post">
            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="LawFirmId" />

            <div class="row g-3">

                <div class="col-md-6">
                    <label asp-for="FirmName" class="form-label">@L.Short Name</label>
                    <input asp-for="FirmName" class="form-control" />
                    <span asp-validation-for="FirmName" class="text-danger"></span>
                </div>

                <div class="col-md-3">
                    <label asp-for="ShortName" class="form-label">Short Name</label>
                    <input asp-for="ShortName" class="form-control" />
                    <span asp-validation-for="ShortName" class="text-danger"></span>
                </div>

                <div class="col-md-3">
                    <label asp-for="Status" class="form-label">Status</label>
                    <select asp-for="Status" class="form-select">
                        <option value="Active">Active</option>
                        <option value="Inactive">Inactive</option>
                    </select>
                    <span asp-validation-for="Status" class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="MainPhone" class="form-label">Phone</label>
                    <input asp-for="MainPhone" class="form-control" />
                    <span asp-validation-for="MainPhone" class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="MainEmail" class="form-label">Email</label>
                    <input asp-for="MainEmail" class="form-control" />
                    <span asp-validation-for="MainEmail" class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="Website" class="form-label">Website</label>
                    <input asp-for="Website" class="form-control" />
                </div>

                <div class="col-md-6">
                    <label asp-for="Address1" class="form-label">Address 1</label>
                    <input asp-for="Address1" class="form-control" />
                    <span asp-validation-for="Address1" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Address2" class="form-label">Address 2</label>
                    <input asp-for="Address2" class="form-control" />
                </div>

                <div class="col-md-4">
                    <label asp-for="City" class="form-label">City</label>
                    <input asp-for="City" class="form-control" />
                    <span asp-validation-for="City" class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="State" class="form-label">State</label>
                    <input asp-for="State" class="form-control" />
                    <span asp-validation-for="State" class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="Zip" class="form-label">Zip</label>
                    <input asp-for="Zip" class="form-control" />
                    <span asp-validation-for="Zip" class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="EIN" class="form-label">EIN</label>
                    <input asp-for="EIN" class="form-control" placeholder="12-3456789 or 123-45-6789" />
                    <span asp-validation-for="EIN" class="text-danger"></span>
                </div>

                <div class="col-12">
                    <label asp-for="ProfileNotes" class="form-label">Profile Notes</label>
                    <textarea asp-for="ProfileNotes" class="form-control" rows="5"></textarea>
                </div>

            </div>
        </form>

        <div class="mt-3">
            <button type="submit" form="@mainFormId" formnovalidate class="btn btn-primary">
                Save Changes
            </button>
        </div>
    </div>
</div>
