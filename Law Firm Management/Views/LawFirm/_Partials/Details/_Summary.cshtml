@model Law_Firm_Management.Models.LawFirmEditVm

<div class="card shadow-sm mb-3">
    <div class="card-header">
        <h5 class="mb-0">Summary</h5>
    </div>
    <div class="card-body">
        <div class="d-flex justify-content-between">
            <span>States</span>
            <strong>@Model.StateMappings.Count</strong>
        </div>
        <div class="d-flex justify-content-between mt-2">
            <span>Contacts</span>
            <strong>@Model.Contacts.Count</strong>
        </div>
        <div class="d-flex justify-content-between mt-2">
            <span>Notes</span>
            <strong>@Model.Notes.Count</strong>
        </div>
    </div>
</div>
