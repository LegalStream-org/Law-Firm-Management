@model Law_Firm_Management.Models.LawFirmEditVm


@{
    var L = Law_Firm_Management.Models.LawFirmRecordLabels.From(ViewData);
    ViewData["Title"] = $"{L.Full} Details";
}

<div class="container-fluid py-3">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="mb-0">@Model.FirmName</h2>
            <div class="text-muted">@L.Full Details</div>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary">Back</a>
            <a asp-action="Edit" asp-route-id="@Model.LawFirmId" class="btn btn-primary">Edit</a>
        </div>
    </div>

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success">@TempData["Message"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="row g-3">
        <div class="col-12 col-lg-8">

            <partial name="_Partials/Details/_Profile.cshtml" />

            <partial name="_Partials/Details/_StateMappings.cshtml" />

            <partial name="_Partials/Details/_Contacts.cshtml" />

            <partial name="_Partials/Details/_Notes.cshtml" />

            <partial name="_Partials/Details/_Documents.cshtml" />

        </div>

        <div class="col-12 col-lg-4">
            <partial name="_Partials/Details/_Summary.cshtml" />

            <partial name="_Partials/Details/_AccountingActivity.cshtml" />

            <partial name="_Partials/Details/_AccountingMapping.cshtml" />

            <partial name="_Partials/Details/_Audit.cshtml" />

        </div>
    </div>
</div>

