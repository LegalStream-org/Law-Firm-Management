@model Law_Firm_Management.Models.ClientTypeEditVm

@{
    ViewData["Title"] = "Edit Client Type";
}

<h2>Edit Client Type</h2>

<form asp-action="EditClientType" method="post" class="mb-4">
    @Html.AntiForgeryToken()
    <input asp-for="ClientTypeId" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="TypeName" class="form-label"></label>
            <input asp-for="TypeName" class="form-control" autocomplete="off" />
            <span asp-validation-for="TypeName" class="text-danger"></span>
        </div>

        <div class="col-md-6">
            <label asp-for="Description" class="form-label"></label>
            <input asp-for="Description" class="form-control" />
        </div>

        <div class="col-md-6">
            <div class="form-check mt-4">
                <input asp-for="SuppressCommissionByDefault" class="form-check-input" />
                <label asp-for="SuppressCommissionByDefault" class="form-check-label"></label>
            </div>
            <div class="form-text">
                When set, the Accounting picker will default the commission checkbox to unchecked
                for clients assigned this type. Still user-overridable.
            </div>
        </div>

        <div class="col-md-6">
            <div class="form-check mt-4">
                <input asp-for="IsActive" class="form-check-input" />
                <label asp-for="IsActive" class="form-check-label"></label>
            </div>
            <div class="form-text">
                Inactive types drop out of the Client Create/Edit dropdown but stay intact
                on any client already assigned this type.
            </div>
        </div>
    </div>

    <div class="mt-4">
        <button type="submit" class="btn btn-primary">Save</button>
        <a asp-action="ClientTypes" class="btn btn-outline-secondary">Cancel</a>
    </div>
</form>
