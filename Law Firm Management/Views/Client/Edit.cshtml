@model Law_Firm_Management.Models.ClientEditVm

@{
    ViewData["Title"] = "Edit Client";
}

<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h2>Edit Client</h2>
        <div class="page-subtitle">@Model.ClientName</div>
    </div>
    <div>
        <a asp-action="Details" asp-route-id="@Model.ClientId" class="btn btn-outline-secondary">View Details</a>
    </div>
</div>

@if (TempData["Message"] != null)
{
    <div class="alert alert-success">@TempData["Message"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-warning">@TempData["Error"]</div>
}

<form asp-action="Edit" method="post" class="mb-4">
    @Html.AntiForgeryToken()
    <input asp-for="ClientId" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="ClientName" class="form-label"></label>
            <input asp-for="ClientName" class="form-control" />
            <span asp-validation-for="ClientName" class="text-danger"></span>
        </div>

        <div class="col-md-3">
            <label asp-for="ShortName" class="form-label"></label>
            <input asp-for="ShortName" class="form-control" />
        </div>

        <div class="col-md-3">
            <label asp-for="Status" class="form-label"></label>
            <select asp-for="Status" class="form-select">
                <option value="Active">Active</option>
                <option value="Inactive">Inactive</option>
            </select>
        </div>

        <div class="col-md-4">
            <label asp-for="MainPhone" class="form-label"></label>
            <input asp-for="MainPhone" class="form-control" />
        </div>

        <div class="col-md-4">
            <label asp-for="MainEmail" class="form-label"></label>
            <input asp-for="MainEmail" class="form-control" />
        </div>

        <div class="col-md-4">
            <label asp-for="Website" class="form-label"></label>
            <input asp-for="Website" class="form-control" />
        </div>

        <div class="col-md-6">
            <label asp-for="Address1" class="form-label"></label>
            <input asp-for="Address1" class="form-control" />
        </div>

        <div class="col-md-6">
            <label asp-for="Address2" class="form-label"></label>
            <input asp-for="Address2" class="form-control" />
        </div>

        <div class="col-md-4">
            <label asp-for="City" class="form-label"></label>
            <input asp-for="City" class="form-control" />
        </div>

        <div class="col-md-4">
            <label asp-for="State" class="form-label"></label>
            <input asp-for="State" class="form-control" />
        </div>

        <div class="col-md-4">
            <label asp-for="Zip" class="form-label"></label>
            <input asp-for="Zip" class="form-control" />
        </div>

        <div class="col-12">
            <label asp-for="ProfileNotes" class="form-label"></label>
            <textarea asp-for="ProfileNotes" class="form-control" rows="4"></textarea>
        </div>
    </div>

    <div class="mt-4 d-flex gap-2">
        <button type="submit" class="btn btn-primary">Save Changes</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Back</a>
    </div>
</form>

<hr />

<h4 class="mb-3">Contacts</h4>

<form asp-action="AddContact" method="post" class="mb-4">
    @Html.AntiForgeryToken()
    <input type="hidden" name="ClientId" value="@Model.ClientId" />

    <div class="row g-2">
        <div class="col-md-2">
            <select name="ContactType" class="form-select">
                <option value="">Type</option>
                @foreach (var item in Model.ContactTypeOptions)
                {
                    <option value="@item">@item</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <input name="ContactName" class="form-control" placeholder="Contact Name" />
        </div>
        <div class="col-md-2">
            <input name="Title" class="form-control" placeholder="Title" />
        </div>
        <div class="col-md-2">
            <input name="Email" class="form-control" placeholder="Email" />
        </div>
        <div class="col-md-2">
            <input name="Phone" class="form-control" placeholder="Phone" />
        </div>
        <div class="col-md-2">
            <input name="PreferredContactMethod" class="form-control" placeholder="Preferred Method" />
        </div>
        <div class="col-md-2">
            <select name="IsActive" class="form-select">
                <option value="true">Active</option>
                <option value="false">Inactive</option>
            </select>
        </div>
        <div class="col-md-8">
            <input name="Notes" class="form-control" placeholder="Notes" />
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-primary w-100">Add Contact</button>
        </div>
    </div>
</form>

<table class="table table-striped table-hover mb-4">
    <thead>
        <tr>
            <th>Type</th>
            <th>Name</th>
            <th>Title</th>
            <th>Email</th>
            <th>Phone</th>
            <th>Preferred</th>
            <th>Active</th>
            <th>Notes</th>
            <th style="width:100px;">Delete</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Contacts == null || !Model.Contacts.Any())
        {
            <tr>
                <td colspan="9" class="text-center">No contacts found.</td>
            </tr>
        }
        else
        {
            @foreach (var contact in Model.Contacts)
            {
                <tr>
                    <td>@contact.ContactType</td>
                    <td>@contact.ContactName</td>
                    <td>@contact.Title</td>
                    <td>@contact.Email</td>
                    <td>@contact.Phone</td>
                    <td>@contact.PreferredContactMethod</td>
                    <td>@(contact.IsActive ? "Yes" : "No")</td>
                    <td>@contact.Notes</td>
                    <td>
                        <form asp-action="DeleteContact" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="clientContactId" value="@contact.ClientContactId" />
                            <input type="hidden" name="clientId" value="@Model.ClientId" />
                            <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>

<hr />

<h4 class="mb-3">Portfolio / CLS FORW_NO Mapping</h4>

<form asp-action="AddPortfolio" method="post" class="mb-4">
    @Html.AntiForgeryToken()
    <input type="hidden" name="ClientId" value="@Model.ClientId" />

    <div class="row g-2">
        <div class="col-md-3">
            <input name="PortfolioName" class="form-control" placeholder="Portfolio Name" />
        </div>
        <div class="col-md-2">
            <input name="PortfolioCode" class="form-control" placeholder="Portfolio Code" />
        </div>
        <div class="col-md-2">
            <input name="ForwNo" class="form-control" placeholder="CLS FORW_NO" />
        </div>
        <div class="col-md-2">
            <select name="IsActive" class="form-select">
                <option value="true">Active</option>
                <option value="false">Inactive</option>
            </select>
        </div>
        <div class="col-md-3">
            <button type="submit" class="btn btn-primary w-100">Add Portfolio Mapping</button>
        </div>
    </div>
</form>

<table class="table table-striped table-hover mb-4">
    <thead>
        <tr>
            <th>Portfolio Name</th>
            <th>Portfolio Code</th>
            <th>CLS FORW_NO</th>
            <th>Active</th>
            <th style="width:120px;">Delete</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Portfolios == null || !Model.Portfolios.Any())
        {
            <tr>
                <td colspan="5" class="text-center">No portfolio mappings found.</td>
            </tr>
        }
        else
        {
            @foreach (var p in Model.Portfolios)
            {
                <tr>
                    <td>@p.PortfolioName</td>
                    <td>@p.PortfolioCode</td>
                    <td>@p.ForwNo</td>
                    <td>@(p.IsActive ? "Yes" : "No")</td>
                    <td>
                        <form asp-action="DeletePortfolio" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="clientPortfolioId" value="@p.ClientPortfolioId" />
                            <input type="hidden" name="clientId" value="@Model.ClientId" />
                            <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                        </form>
                    </td>
                </tr>

                <tr>
                    <td colspan="5">
                        <form asp-action="UpdatePortfolio" method="post" class="row g-2">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="ClientPortfolioId" value="@p.ClientPortfolioId" />
                            <input type="hidden" name="ClientId" value="@Model.ClientId" />

                            <div class="col-md-3">
                                <input name="PortfolioName" value="@p.PortfolioName" class="form-control form-control-sm" />
                            </div>
                            <div class="col-md-2">
                                <input name="PortfolioCode" value="@p.PortfolioCode" class="form-control form-control-sm" />
                            </div>
                            <div class="col-md-2">
                                <input name="ForwNo" value="@p.ForwNo" class="form-control form-control-sm" />
                            </div>
                            <div class="col-md-2">
                                <select name="IsActive" class="form-select form-select-sm">
                                    @if (p.IsActive)
                                    {
                                        <option value="true" selected>Active</option>
                                        <option value="false">Inactive</option>
                                    }
                                    else
                                    {
                                        <option value="true">Active</option>
                                        <option value="false" selected>Inactive</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-3">
                                <button type="submit" class="btn btn-sm btn-outline-primary w-100">Save Changes</button>
                            </div>
                        </form>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>

@* Aug 19 - Accounting Mapping, the Client-side equivalent of LawFirm's own "Accounting Mapping"
   card. Deliberately matches THIS page's own style (h4/hr/table, mirroring the Portfolio section
   right above) rather than LawFirm Edit's Bootstrap-card layout - a different page's convention,
   not this one's. *@
<h4 class="mb-3">Accounting Mapping</h4>

<form asp-action="AddAccountingMap" method="post" class="mb-4">
    @Html.AntiForgeryToken()
    <input type="hidden" name="ClientId" value="@Model.ClientId" />

    <div class="row g-2">
        <div class="col-md-6">
            <select name="AccountingClientName" class="form-select">
                <option value="">Select Client</option>
                @foreach (var c in Model.AccountingClientOptions)
                {
                    <option value="@c">@c</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <select name="isActive" class="form-select">
                <option value="true">Active</option>
                <option value="false">Inactive</option>
            </select>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-primary w-100">Add Mapping</button>
        </div>
    </div>
</form>

<table class="table table-striped table-hover mb-4">
    <thead>
        <tr>
            <th>Accounting Client</th>
            <th>Active</th>
            <th style="width:160px;">Actions</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.AccountingMaps == null || !Model.AccountingMaps.Any())
        {
            <tr>
                <td colspan="3" class="text-center">No accounting mappings found.</td>
            </tr>
        }
        else
        {
            @foreach (var m in Model.AccountingMaps)
            {
                var formId = $"acctMap_{m.ClientAccountingMapId}";

                <tr>
                    <td>
                        <select name="accountingClientName" form="@formId" class="form-select form-select-sm">
                            @foreach (var c in Model.AccountingClientOptions)
                            {
                                <option value="@c" selected="@(c == m.AccountingClientName)">@c</option>
                            }
                        </select>
                    </td>
                    <td class="text-center">
                        @if (m.IsActive)
                        {
                            <input type="checkbox" name="isActive" value="true" form="@formId" checked="checked" />
                        }
                        else
                        {
                            <input type="checkbox" name="isActive" value="true" form="@formId" />
                        }
                        <input type="hidden" name="isActive" value="false" form="@formId" />
                    </td>
                    <td>
                        <div class="d-flex gap-1">
                            <form id="@formId" asp-action="UpdateAccountingMap" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="clientAccountingMapId" value="@m.ClientAccountingMapId" />
                                <input type="hidden" name="clientId" value="@Model.ClientId" />
                                <button type="submit" class="btn btn-sm btn-outline-primary">Save</button>
                            </form>
                            <form asp-action="DeleteAccountingMap" method="post" class="d-inline"
                                  onsubmit="return confirm('Delete this accounting mapping?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="clientAccountingMapId" value="@m.ClientAccountingMapId" />
                                <input type="hidden" name="clientId" value="@Model.ClientId" />
                                <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>

@* Sep 08 - reassignment confirmation, rendered only right after Add/UpdateAccountingMap bounced back
   on a mapping another client holds. Continue replays the refused post from the stashed attempt (the
   form above has been reset by the redirect); Cancel posts nothing, so nothing changes. *@
@if (Model.PendingAccountingMapConflict != null)
{
    var pending = Model.PendingAccountingMapConflict;

    <div class="modal fade" id="accountingMapConflictModal" tabindex="-1"
         aria-labelledby="accountingMapConflictModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="accountingMapConflictModalLabel">Accounting Mapping Already Assigned</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-0">@pending.Message</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>

                    <form asp-action="@pending.PostAction" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="clientId" value="@pending.ClientId" />
                        <input type="hidden" name="clientAccountingMapId" value="@pending.ClientAccountingMapId" />
                        <input type="hidden" name="accountingClientName" value="@pending.AccountingClientName" />
                        <input type="hidden" name="isActive" value="@(pending.IsActive ? "true" : "false")" />
                        <input type="hidden" name="confirmReassign" value="true" />
                        <button type="submit" class="btn btn-primary">Continue</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}

<hr />

<h4 class="mb-3">Notes</h4>

<form asp-action="AddNote" method="post" class="mb-4">
    @Html.AntiForgeryToken()
    <input type="hidden" name="ClientId" value="@Model.ClientId" />
    <input type="hidden" name="returnAction" value="Edit" />

    <div class="row g-2">
        <div class="col-md-3">
            <select name="NoteType" class="form-select">
                @foreach (var item in Model.NoteOptions)
                {
                    <option value="@item">@item</option>
                }
            </select>
        </div>
        <div class="col-md-7">
            <input name="NoteText" class="form-control" placeholder="Enter note" />
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-primary w-100">Add Note</button>
        </div>
    </div>
</form>

<table class="table table-striped table-hover mb-4">
    <thead>
        <tr>
            <th>Type</th>
            <th>Note</th>
            <th>Entered By</th>
            <th>Entered Date</th>
            <th style="width:100px;">Delete</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Notes == null || !Model.Notes.Any())
        {
            <tr>
                <td colspan="5" class="text-center">No notes found.</td>
            </tr>
        }
        else
        {
            @foreach (var note in Model.Notes)
            {
                <tr>
                    <td>@note.NoteType</td>
                    <td>@note.NoteText</td>
                    <td>@note.EnteredBy</td>
                    <td>@note.EnteredDate.ToString("MM/dd/yyyy hh:mm tt")</td>
                    <td>
                        <form asp-action="DeleteNote" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="clientNoteId" value="@note.ClientNoteId" />
                            <input type="hidden" name="clientId" value="@Model.ClientId" />
                            <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>

<h4 class="mb-3">Audit History</h4>
<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Entity</th>
            <th>Action</th>
            <th>Text</th>
            <th>By</th>
            <th>Date</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.AuditHistory == null || !Model.AuditHistory.Any())
        {
            <tr>
                <td colspan="5" class="text-center">No audit history found.</td>
            </tr>
        }
        else
        {
            @foreach (var audit in Model.AuditHistory)
            {
                <tr>
                    <td>@audit.EntityType</td>
                    <td>@audit.ActionType</td>
                    <td>@audit.AuditText</td>
                    <td>@audit.EnteredBy</td>
                    <td>@audit.EnteredDate.ToString("MM/dd/yyyy hh:mm tt")</td>
                </tr>
            }
        }
    </tbody>
</table>

<div class="mt-4">
    <form asp-action="DeleteClient" method="post" onsubmit="return confirm('Delete this client?');">
        @Html.AntiForgeryToken()
        <input type="hidden" name="clientId" value="@Model.ClientId" />
        <button type="submit" class="btn btn-danger">Delete Client</button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    @if (Model.PendingAccountingMapConflict != null)
    {
        @* Sep 08 - the warning is the point of the redirect, so it opens itself. Bootstrap's bundle is
           already loaded by _Layout above this section. *@
        <script>
            document.addEventListener("DOMContentLoaded", function () {
                var conflictModal = document.getElementById("accountingMapConflictModal");
                if (conflictModal) {
                    new bootstrap.Modal(conflictModal).show();
                }
            });
        </script>
    }
}