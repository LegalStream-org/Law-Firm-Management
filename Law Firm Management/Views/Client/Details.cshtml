@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <link href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.15/index.global.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.15/index.global.min.js"></script>

  <script>
    document.addEventListener('DOMContentLoaded', function () {
        const calendarEl = document.getElementById('taskCalendar');
        if (!calendarEl) return;

        const setText = (id, value) => {
            const el = document.getElementById(id);
            if (el) el.textContent = value && value.toString().trim() !== '' ? value : '-';
        };

        const calendar = new FullCalendar.Calendar(calendarEl, {
            initialView: 'dayGridMonth',
            height: 750,
            headerToolbar: {
                left: 'prev,next today',
                center: 'title',
                right: 'dayGridMonth,timeGridWeek,listMonth'
            },
            events: function (fetchInfo, successCallback, failureCallback) {
              const url =
    '@Url.Action("TaskCalendarEvents", "Client")' +
    '?clientId=@Model.ClientId' +
    '&start=' + encodeURIComponent(fetchInfo.startStr) +
    '&end=' + encodeURIComponent(fetchInfo.endStr);

                console.log('Calendar URL:', url);

                fetch(url)
                    .then(r => {
                        console.log('Calendar status:', r.status);
                        return r.json();
                    })
                    .then(data => {
                        console.log('Calendar data:', data);
                        successCallback(data);
                    })
                    .catch(err => {
                        console.error('Calendar error:', err);
                        failureCallback(err);
                    });
            },
            eventClick: function (info) {
                const p = info.event.extendedProps || {};

                setText('modalTaskName', p.taskName || info.event.title);
                setText('modalTaskType', p.taskType);
                setText('modalAssignedTo', p.assignedTo);
                setText('modalFrequency', p.frequency);
                setText('modalDueDay', p.dueDay);
                setText('modalDelivery', p.deliveryMethod);
                setText('modalSftp', p.clientSftpConfigId);
                setText('modalOccurrenceDate', info.event.startStr);
                setText('modalNextDueDate', p.nextDueDate);
                setText('modalNotes', p.notes);

                const modalEl = document.getElementById('taskEventModal');

                if (window.bootstrap && modalEl) {
                    const taskEventModal = new bootstrap.Modal(modalEl);
                    taskEventModal.show();
                } else {
                    alert(info.event.title);
                }
            }
        });

        calendar.render();
    });
</script>

    <style>
        #taskCalendar {
            max-width: 100%;
        }

        .fc .fc-toolbar-title {
            font-size: 1.15rem;
            font-weight: 600;
        }

        .fc-event {
            cursor: pointer;
        }
    </style>
}