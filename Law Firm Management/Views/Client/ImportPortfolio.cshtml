@{
    ViewData["Title"] = "Import Client Portfolio Mapping";
}

<h2>Import Client Portfolio Mapping</h2>

@if (TempData["Message"] != null)
{
    <div class="alert alert-success">@TempData["Message"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-warning">@Html.Raw(TempData["Error"])</div>
}

<form asp-action="ImportPortfolio" asp-controller="Client" method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    <div class="mb-3">
        <label class="form-label">CSV File</label>
        <input type="file" name="file" class="form-control" accept=".csv" />
    </div>

    <button type="submit" class="btn btn-primary">Import Portfolio</button>
    <a asp-action="DownloadClientPortfolioTemplate" class="btn btn-outline-secondary">Download Template</a>
    <a asp-action="Index" class="btn btn-secondary">Back</a>
</form>