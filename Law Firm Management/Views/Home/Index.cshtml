@model Law_Firm_Management.Models.HomeDashboardVm

@{
    ViewData["Title"] = "Dashboard";
}

<div class="container-fluid py-3">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-0">Dashboard</h2>
            <div class="text-muted">Overview of firms, clients, imports, and recent activity.</div>
        </div>
    </div>

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success">@TempData["Message"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small">Total Law Firms</div>
                    <h3 class="mb-0">@Model.TotalLawFirms</h3>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small">Active Law Firms</div>
                    <h3 class="mb-0">@Model.ActiveLawFirms</h3>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small">Total Clients</div>
                    <h3 class="mb-0">@Model.TotalClients</h3>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small">Active Clients</div>
                    <h3 class="mb-0">@Model.ActiveClients</h3>
                </div>
            </div>
        </div>
    </div>



    <div class="row g-3 mb-4">
        <div class="col-lg-8">
            <div class="card shadow-sm h-100">
                <div class="card-header">
                    <h5 class="mb-0">Quick Actions</h5>
                </div>
                <div class="card-body">
                    <div class="row g-2">
                        <div class="col-md-4">
                            <a asp-controller="LawFirm" asp-action="Create" class="btn btn-primary w-100">Add Law Firm</a>
                        </div>
                        <div class="col-md-4">
                            <a asp-controller="Client" asp-action="Create" class="btn btn-primary w-100">Add Client</a>
                        </div>
                        <div class="col-md-4">
                            <a asp-controller="LawFirm" asp-action="Import" class="btn btn-outline-primary w-100">Import Firms</a>
                        </div>
                        <div class="col-md-4">
                            <a asp-controller="Client" asp-action="Import" class="btn btn-outline-primary w-100">Import Clients</a>
                        </div>
                        <div class="col-md-4">
                            <a asp-controller="LawFirm" asp-action="ImportContacts" class="btn btn-outline-secondary w-100">Import Firm Contacts</a>
                        </div>
                        <div class="col-md-4">
                            <a asp-controller="Client" asp-action="ImportContacts" class="btn btn-outline-secondary w-100">Import Client Contacts</a>
                        </div>
                        <div class="col-md-4">
                            <a asp-controller="LawFirm" asp-action="ImportStateMappings" class="btn btn-outline-secondary w-100">Import State Mappings</a>
                        </div>
                        <div class="col-md-4">
                            <a asp-controller="LawFirm" asp-action="Export" class="btn btn-outline-dark w-100">Export Firms</a>
                        </div>
                        <div class="col-md-4">
                            <a asp-controller="Client" asp-action="Export" class="btn btn-outline-dark w-100">Export Clients</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card shadow-sm h-100">
                <div class="card-header">
                    <h5 class="mb-0">Management Areas</h5>
                </div>
                <div class="card-body">
                    <div class="list-group">
                        <a asp-controller="LawFirm" asp-action="Index" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                            Law Firms
                            <span class="badge bg-primary rounded-pill">@Model.TotalLawFirms</span>
                        </a>
                        <a asp-controller="Client" asp-action="Index" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                            Clients
                            <span class="badge bg-primary rounded-pill">@Model.TotalClients</span>
                        </a>
                        <a asp-controller="LawFirm" asp-action="Import" class="list-group-item list-group-item-action">
                            Imports
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-lg-6">
            <div class="card shadow-sm h-100">
                <div class="card-header">
                    <h5 class="mb-0">Recent Law Firms</h5>
                </div>
                <div class="card-body">
                    <table class="table table-sm table-hover mb-0">
                        <thead>
                            <tr>
                                <th>Firm</th>
                                <th>Status</th>
                                <th>Updated</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.RecentLawFirms == null || !Model.RecentLawFirms.Any())
                            {
                                <tr>
                                    <td colspan="3" class="text-muted">No law firms found.</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var item in Model.RecentLawFirms)
                                {
                                    <tr>
                                        <td>
                                            <a asp-controller="LawFirm" asp-action="Details" asp-route-id="@item.LawFirmId">
                                                @item.FirmName
                                            </a>
                                        </td>
                                        <td>@item.Status</td>
                                        <td>@(item.UpdatedDate?.ToString("MM/dd/yyyy") ?? "")</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card shadow-sm h-100">
                <div class="card-header">
                    <h5 class="mb-0">Recent Clients</h5>
                </div>
                <div class="card-body">
                    <table class="table table-sm table-hover mb-0">
                        <thead>
                            <tr>
                                <th>Client</th>
                                <th>Status</th>
                                <th>Updated</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.RecentClients == null || !Model.RecentClients.Any())
                            {
                                <tr>
                                    <td colspan="3" class="text-muted">No clients found.</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var item in Model.RecentClients)
                                {
                                    <tr>
                                        <td>
                                            <a asp-controller="Client" asp-action="Details" asp-route-id="@item.ClientId">
                                                @item.ClientName
                                            </a>
                                        </td>
                                        <td>@item.Status</td>
                                        <td>@(item.UpdatedDate?.ToString("MM/dd/yyyy") ?? "")</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

</div>